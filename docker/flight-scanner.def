# Apptainer image for scripts/apptainer.sh: the toolchain that scripts/start.sh's local mode needs
# (PostgreSQL 16, Python 3.12 + uv, Node 22, curl). The code, venv and state stay on the host.
# Based on the official postgres image (x86_64 and arm64) so no Postgres package has to be
# installed: its postinst scripts fail under an unprivileged --fakeroot build.
#
#   apptainer build --fakeroot flight-scanner.sif docker/flight-scanner.def
Bootstrap: docker
From: postgres:16-bookworm

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    UV_VERSION=0.9.5
    NODE_VERSION=22.20.0
    case "$(uname -m)" in
        x86_64) UV_ARCH=x86_64 NODE_ARCH=x64 ;;
        aarch64) UV_ARCH=aarch64 NODE_ARCH=arm64 ;;
        *) echo "unsupported architecture $(uname -m)" >&2; exit 1 ;;
    esac

    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl procps xz-utils
    rm -rf /var/lib/apt/lists/*

    curl -fsSL "https://github.com/astral-sh/uv/releases/download/$UV_VERSION/uv-$UV_ARCH-unknown-linux-gnu.tar.gz" \
        | tar -xz --strip-components=1 --no-same-owner -C /usr/local/bin
    curl -fsSL "https://nodejs.org/dist/v$NODE_VERSION/node-v$NODE_VERSION-linux-$NODE_ARCH.tar.xz" \
        | tar -xJ --strip-components=1 --no-same-owner -C /usr/local
    UV_PYTHON_INSTALL_DIR=/opt/python uv python install 3.12
    chmod -R a+rX /opt/python

%environment
    export PATH=/usr/lib/postgresql/16/bin:/usr/local/bin:/usr/bin:/bin
    export LANG=C.UTF-8 LC_ALL=C.UTF-8
    # Use the image's Python 3.12, never a downloaded or host one.
    export UV_PYTHON_INSTALL_DIR=/opt/python UV_PYTHON=3.12 UV_PYTHON_PREFERENCE=only-managed
    export UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy

%labels
    org.opencontainers.image.title flight-scanner-runtime
