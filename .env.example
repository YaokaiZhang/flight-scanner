# Copy to .env (never commit .env). Every secret and setting comes from the environment.

# --- Postgres (app data in POSTGRES_DB, Dagster's storage in DAGSTER_PG_DB) ---
POSTGRES_USER=flightscanner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flightscanner
DAGSTER_PG_DB=dagster

# --- Pipeline ---
# Comma-separated enabled sources. "fake" replays FS_FAKE_PAYLOAD_DIR (<ORIG>-<DEST>*.json files).
FS_SOURCES=
FS_FAKE_PAYLOAD_DIR=
# Comma-separated notifiers: log (Dagster logs), email, telegram. Each Watch chooses email,
# Telegram or both; "log" gets every Alert.
FS_NOTIFIERS=log

# --- Email Alerts (FS_NOTIFIERS=...,email) ---
SMTP_HOST=
# starttls (default, port 587), ssl (port 465) or none (port 25)
SMTP_SECURITY=starttls
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender; defaults to SMTP_USER. Recipients are comma-separated.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Telegram Alerts (FS_NOTIFIERS=...,telegram) ---
# Bot token from @BotFather; chat id of your chat with the bot. 👍/👎 taps are polled
# (getUpdates) by the telegram_feedback sensor, so no webhook or public URL is needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Later tickets (unused until then) ---
TRAVELPAYOUTS_TOKEN=
SERPAPI_API_KEY=
# Unofficial airline adapters stay off unless explicitly enabled (see ADR-0002).
FS_ENABLE_RYANAIR=false
FS_ENABLE_WIZZ=false
