# Copy to .env (never commit .env). Every secret and setting comes from the environment.

# --- Postgres (app data in POSTGRES_DB, Dagster's storage in DAGSTER_PG_DB) ---
POSTGRES_USER=flightscanner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flightscanner
DAGSTER_PG_DB=dagster

# --- Pipeline ---
# Comma-separated enabled sources: "travelpayouts" (real cached prices; needs TRAVELPAYOUTS_TOKEN),
# "fake" (replays FS_FAKE_PAYLOAD_DIR <ORIG>-<DEST>*.json files), and the optional "ryanair" /
# "wizz" calendar adapters (also need FS_ENABLE_RYANAIR / FS_ENABLE_WIZZ: read the terms note below).
FS_SOURCES=
# Request budget per source for the scan planner: N/run and/or N/day (Helsinki day), joined
# with "+". Tasks over budget are skipped and listed at GET /scan-tasks?status=skipped.
# Unlisted sources are unlimited. Example: travelpayouts=200/run+5000/day
FS_SCAN_BUDGETS=
FS_FAKE_PAYLOAD_DIR=

# --- Travelpayouts (Aviasales Data API) ---
# The real API token goes here: Travelpayouts dashboard -> Profile -> API token.
# Sent only as the X-Access-Token header; never stored with raw payloads.
TRAVELPAYOUTS_TOKEN=
# Client-side rate limit and retry budget (429/5xx/network errors back off exponentially).
FS_TRAVELPAYOUTS_REQUESTS_PER_MINUTE=60
FS_TRAVELPAYOUTS_MAX_RETRIES=4
# Comma-separated notifiers: log (Dagster logs), email, telegram. Each Watch chooses email,
# Telegram or both; "log" gets every Alert.
FS_NOTIFIERS=log

# --- Email Alerts (FS_NOTIFIERS=...,email) ---
SMTP_HOST=
# starttls (default, port 587), ssl (port 465) or none (port 25)
SMTP_SECURITY=starttls
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender; defaults to SMTP_USER. Recipients are comma-separated.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Telegram Alerts (FS_NOTIFIERS=...,telegram) ---
# Bot token from @BotFather; chat id of your chat with the bot. 👍/👎 taps are polled
# (getUpdates) by the telegram_feedback sensor, so no webhook or public URL is needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Deal context (optional): "why is this cheap?" line on Alerts and in the Deals feed ---
# FS_DEAL_CONTEXT=claude turns on a Claude agent with web search (never used as a price source;
# an Alert waits at most 60 s for it). Leave empty to run without it.
FS_DEAL_CONTEXT=
# API key from console.anthropic.com; only read from the environment, never stored.
ANTHROPIC_API_KEY=
# Optional overrides (defaults: claude-opus-5-5, effort low).
FS_DEAL_CONTEXT_MODEL=
FS_DEAL_CONTEXT_EFFORT=

# --- Verification (optional): live check of the best Candidates on Google Flights ---
# FS_VERIFIER=serpapi checks Candidates through SerpApi's google_flights engine (round trip, the
# Watch's adults) and stores Google's Price insight as a Baseline tier. Empty: every Deal is
# alerted Unverified. The key is added to the request URL only, never stored.
FS_VERIFIER=
SERPAPI_API_KEY=
# Free tier: 250 searches a month, spent at most this many a day (Helsinki days).
FS_SERPAPI_DAILY_BUDGET=8
FS_SERPAPI_MONTHLY_BUDGET=250

# --- Ryanair / Wizz Air calendar adapters (optional, OFF by default; ADR-0002) ---
# TERMS OF SERVICE: these adapters read the public fare calendars that ryanair.com and
# wizzair.com use themselves. They are NOT official APIs: both airlines' website terms forbid
# automated access (screen scraping, bots), Ryanair has taken scrapers to court, and either
# airline may change or close the endpoints at any time. Enabling one is your own decision and
# your responsibility; it is meant for low-volume personal use only.
# What the adapters do: one request per route and month, about 6 a minute (configurable), at
# most 20 a run / 300 a day by default (FS_SCAN_BUDGETS overrides), each route-month at most
# every 2 h, and backoff on 429/5xx. What they never do: proxy rotation, browser impersonation,
# CAPTCHA solving or any other way around bot protection. When a site turns them away (403,
# challenge page) the adapter disables itself; it shows at GET /sources/blocked (data health)
# and stays off until you run `python -m flight_scanner unblock ryanair|wizz`.
# To enable: add the name to FS_SOURCES *and* set its flag to true.
FS_ENABLE_RYANAIR=false
FS_ENABLE_WIZZ=false
# Optional tuning (defaults shown).
FS_RYANAIR_REQUESTS_PER_MINUTE=6
FS_RYANAIR_MAX_RETRIES=2
FS_WIZZ_REQUESTS_PER_MINUTE=6
FS_WIZZ_MAX_RETRIES=2
# Pin the Wizz API base (e.g. https://be.wizzair.com/27.6.0); empty = read wizzair.com/buildnumber.
FS_WIZZ_API_URL=

# --- Analytical layer: Databricks Free Edition (optional, OFF by default; ADR-0003) ---
# Once a day (04:15 Helsinki, Dagster job `lakehouse`, or `python -m flight_scanner lakehouse`)
# history and staging are exported as Parquet to a Unity Catalog volume, Databricks rebuilds
# Baselines and the backtest with the shared dbt models, and its Baselines are written back as
# new versions (method databricks/...). Never on the alerting path: when Databricks is down or
# over quota, detection keeps the last published Baselines (for up to 7 days, dbt var
# published_baseline_max_age_days), then the Baselines verda recomputes every scan.
# Setup (account, warehouse, job, token): databricks/README.md.
FS_LAKEHOUSE=
DATABRICKS_HOST=
DATABRICKS_TOKEN=
FS_DATABRICKS_JOB_ID=
FS_DATABRICKS_WAREHOUSE_ID=
FS_DATABRICKS_CATALOG=flight_scanner
# Default /Volumes/<catalog>/bronze/exports
FS_DATABRICKS_VOLUME=
FS_DATABRICKS_RUN_TIMEOUT_MINUTES=60
